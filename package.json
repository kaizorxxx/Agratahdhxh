    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.4",
    "typescript": "^5.2.2",
    "vite": "^5.1.0"
  }
